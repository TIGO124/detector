<?xml version="1.0" encoding="utf-8"?>
<!-- Ayarlar yaprağı: kısa ekranlarda kaydırılır. Bölümler (anahtarlar, seçimler) AyarPaneli'nde koddan kurulur. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ayar_kaydirma"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginTop="56dp"
    android:overScrollMode="never"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/ayar_paneli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/yaprak_zemin"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/tutamak" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/YaprakBasligi"
                android:text="Ayarlar" />

            <ImageButton
                android:id="@+id/ayar_kapat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/liste_daire"
                android:contentDescription="Kapat"
                android:src="@drawable/ic_kapat"
                app:tint="@color/yazi_ikincil" />
        </LinearLayout>

        <TextView
            style="@style/BolumEtiketi"
            android:text="ÇİZGİ RENGİ" />

        <LinearLayout
            android:id="@+id/renkler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp" />

        <!-- Gösterim, çekim, yardımcılar, arka plan, hızlandırıcı, yapay zekâ verileri -->
        <LinearLayout
            android:id="@+id/ayar_bolumleri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/ayar_tamam"
            style="@style/AnaDugme"
            android:layout_marginTop="20dp"
            android:text="Tamam" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ayar_hakkinda"
                style="@style/IkincilDugme"
                android:layout_marginEnd="5dp"
                android:text="Hakkında"
                app:drawableStartCompat="@drawable/ic_bilgi" />

            <TextView
                android:id="@+id/ayar_sifirla"
                style="@style/IkincilDugme"
                android:layout_marginStart="5dp"
                android:text="Ayarları sıfırla"
                app:drawableStartCompat="@drawable/ic_sifirla" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
