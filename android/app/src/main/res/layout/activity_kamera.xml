<?xml version="1.0" encoding="utf-8"?>
<!-- Kamera ekranı. Tasarım: Claude Design, "Dedektör Arayüzü" (Kamera, YZ, Ayarlar, Öğret). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/onizleme"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Çizimler; iki parmakla yakınlaştırma ve çift dokunuş da buraya gelir -->
    <app.tigo.dedektor.CizimView
        android:id="@+id/cizim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fotoğraf çekilince kısa beyaz parlama -->
    <View
        android:id="@+id/flas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/white" />

    <!-- Alttaki düğmeler kamera görüntüsünün üstünde okunur kalsın -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/alt_karartma" />

    <!-- Üst: geri, yüz/el/FPS, fener, ayarlar; altında ipucu -->
    <LinearLayout
        android:id="@+id/ust"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/geri"
                style="@style/CamDaire"
                android:contentDescription="Geri"
                android:src="@drawable/ic_geri" />

            <LinearLayout
                style="@style/CamHap"
                android:layout_marginStart="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Yüz"
                    android:src="@drawable/ic_yuz"
                    app:tint="@color/yazi_cam" />

                <TextView
                    android:id="@+id/yuz_sayisi"
                    style="@style/Sayi"
                    android:layout_marginStart="7dp"
                    android:text="0" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="#24FFFFFF" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="El"
                    android:src="@drawable/ic_el"
                    app:tint="@color/yazi_cam" />

                <TextView
                    android:id="@+id/el_sayisi"
                    style="@style/Sayi"
                    android:layout_marginStart="7dp"
                    android:text="0" />

                <View
                    android:id="@+id/fps_ayrac"
                    android:layout_width="1dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="#24FFFFFF" />

                <TextView
                    android:id="@+id/fps"
                    style="@style/Sayi"
                    android:textColor="@color/yazi_cam"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Yalnızca arka kamerada, flaşı olan telefonlarda görünür -->
            <ImageButton
                android:id="@+id/fener"
                style="@style/CamDaire"
                android:layout_marginEnd="8dp"
                android:contentDescription="Fener"
                android:src="@drawable/ic_fener"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/ayarlar"
                style="@style/CamDaire"
                android:contentDescription="Ayarlar"
                android:src="@drawable/ic_ayarlar" />
        </LinearLayout>

        <TextView
            android:id="@+id/ipucu"
            style="@style/Ipucu"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- Video kaydı süresi -->
        <TextView
            android:id="@+id/kayit_suresi"
            style="@style/Ipucu"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:textColor="@color/kayit_acik"
            android:visibility="gone" />

        <!-- Yakınlaştırma göstergesi (ör. 2.0×) -->
        <TextView
            android:id="@+id/yakinlik"
            style="@style/Ipucu"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/space_grotesk_kalin"
            android:textColor="@color/yazi"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Oyunlar ve kutlamalar: ortada büyük yazı -->
    <TextView
        android:id="@+id/oyun_yazisi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/space_grotesk_kalin"
        android:gravity="center"
        android:shadowColor="#CC000000"
        android:shadowRadius="14"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:visibility="gone" />

    <!-- Uyku uyarısı: gözler uzun süre kapalı kalınca -->
    <TextView
        android:id="@+id/uyku_uyarisi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/uyari_zemin"
        android:fontFamily="@font/space_grotesk_kalin"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="28dp"
        android:paddingBottom="16dp"
        android:text="Uyan!"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:visibility="gone" />

    <!-- Öğret ve zamanlayıcı: geri sayım -->
    <TextView
        android:id="@+id/geri_sayim"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="150dp"
        android:background="@drawable/cam_daire"
        android:fontFamily="@font/space_grotesk_kalin"
        android:gravity="center"
        android:textColor="@color/yazi"
        android:textSize="40sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/alt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- Sonuç kartı (yapay zekâ ve oyunlar): etiket, büyük yazı, küçük yazı, işlemler; altta seçim -->
        <LinearLayout
            android:id="@+id/yz_paneli"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/cam_kart"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/yz_etiket"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_cok_kalin"
                        android:letterSpacing="0.1"
                        android:textColor="@color/soluk"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/yz_buyuk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk_kalin"
                        android:textColor="@color/yazi"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/yz_alt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_kalin"
                        android:textColor="@color/soluk"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/yz_islemler"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/yz_secim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/mod_paneli_kaydirma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fadingEdgeLength="24dp"
            android:fillViewport="true"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/mod_paneli"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/modlar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Son çekilen fotoğraf ya da video: dokun aç, basılı tut paylaş -->
            <ImageView
                android:id="@+id/kucuk_resim"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/cam_daire"
                android:contentDescription="Son çekim"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:visibility="invisible" />

            <ImageButton
                android:id="@+id/deklansor"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="44dp"
                android:layout_marginEnd="44dp"
                android:background="@drawable/deklansor"
                android:contentDescription="Fotoğraf çek. Video için basılı tut" />

            <ImageButton
                android:id="@+id/cevir"
                style="@style/CamDaire"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Kamerayı çevir"
                android:src="@drawable/ic_kamera_cevir" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/yaprak_ayarlar" />

    <include layout="@layout/yaprak_ogret" />
</FrameLayout>
