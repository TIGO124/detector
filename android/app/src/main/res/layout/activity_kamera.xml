<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/onizleme"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <app.tigo.dedektor.CizimView
        android:id="@+id/cizim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Fotoğraf çekilince kısa beyaz parlama -->
    <View
        android:id="@+id/flas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/white" />

    <LinearLayout
        android:id="@+id/ust"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/geri"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/yuvarlak_zemin"
            android:contentDescription="Geri"
            android:src="@drawable/ic_geri" />

        <TextView android:id="@+id/yuz_sayisi" style="@style/Hap" />

        <TextView
            android:id="@+id/el_sayisi"
            style="@style/Hap"
            android:layout_marginStart="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView android:id="@+id/fps" style="@style/Hap" />
    </LinearLayout>

    <TextView
        android:id="@+id/ipucu"
        style="@style/Hap"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/oyun_yazisi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:shadowColor="#CC000000"
        android:shadowRadius="12"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/alt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- Yapay zekâ modu: büyük yazı (TİD metni, egzersiz sayacı) ve o bölümün düğmeleri -->
        <LinearLayout
            android:id="@+id/yz_paneli"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/yz_buyuk"
                style="@style/Hap"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="10dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/yz_islemler"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/mod_paneli_kaydirma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/mod_paneli"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/modlar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/ayarlar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/yuvarlak_zemin"
                android:contentDescription="Ayarlar"
                android:src="@drawable/ic_ayarlar" />

            <ImageButton
                android:id="@+id/deklansor"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:background="@drawable/deklansor"
                android:contentDescription="Fotoğraf çek" />

            <ImageButton
                android:id="@+id/cevir"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/yuvarlak_zemin"
                android:contentDescription="Kamerayı çevir"
                android:src="@drawable/ic_kamera_cevir" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ayar_paneli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel_zemin"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ayarlar"
            android:textColor="#E2E8F0"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            style="@style/AyarBasligi"
            android:text="Çizgi rengi" />

        <LinearLayout
            android:id="@+id/renkler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/ayar_yuz_agi"
            style="@style/AyarAnahtari"
            android:text="Yüz ağı" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/ayar_etiketler"
            style="@style/AyarAnahtari"
            android:text="Etiketler (hareket, parmak, ifade)" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/ayar_vucut"
            style="@style/AyarAnahtari"
            android:text="Vücut iskeleti" />

        <TextView
            style="@style/AyarBasligi"
            android:text="Arka plan" />

        <LinearLayout
            android:id="@+id/arka_planlar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/ayar_tamam"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/hap_zemin"
            android:backgroundTint="#00E676"
            android:gravity="center"
            android:text="Tamam"
            android:textColor="#0B1120"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Öğret: kendi hareketlerin, TİD harfleri, kişiler -->
    <LinearLayout
        android:id="@+id/ogret_paneli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel_zemin"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/ogret_baslik"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E2E8F0"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ogret_aciklama"
            style="@style/AyarBasligi"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/ogret_etiket"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/hap_zemin"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="24"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/ogret_kaydet"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/hap_zemin"
                android:backgroundTint="#00E676"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Kaydet"
                android:textColor="#0B1120"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/ogret_durum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#E2E8F0"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/ogret_ilerleme"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ogret_liste_basligi"
            style="@style/AyarBasligi" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ogret_etiketler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ogret_dugmeler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
