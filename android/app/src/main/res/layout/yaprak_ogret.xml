<?xml version="1.0" encoding="utf-8"?>
<!-- Öğret yaprağı: kendi hareketlerin, TİD harfleri, kişiler, nesneler: kısa ekranlarda kaydırılır (üstü kırpılmasın) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ogret_kaydirma"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginTop="56dp"
    android:overScrollMode="never"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/ogret_paneli"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/yaprak_zemin"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/tutamak" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ogret_baslik"
                style="@style/YaprakBasligi" />

            <ImageButton
                android:id="@+id/ogret_kapat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/liste_daire"
                android:contentDescription="Kapat"
                android:src="@drawable/ic_kapat"
                app:tint="@color/yazi_ikincil" />
        </LinearLayout>

        <TextView
            android:id="@+id/ogret_aciklama"
            style="@style/SatirAciklama"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.15" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/ogret_etiket"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/giris_zemin"
                android:fontFamily="@font/manrope_kalin"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="24"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/yazi"
                android:textColorHint="#6B778C"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/ogret_kaydet"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/dolu_hap"
                android:drawablePadding="8dp"
                android:fontFamily="@font/manrope_cok_kalin"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Kaydet"
                android:textColor="@color/vurgu_ustu"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ogret_durum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/manrope_kalin"
            android:textColor="@color/yazi_ikincil"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/ogret_ilerleme"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/ilerleme"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ogret_liste_basligi"
            style="@style/BolumEtiketi" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ogret_etiketler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/ogret_egitim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ogret_egit"
                style="@style/AnaDugme"
                android:layout_marginTop="20dp"
                android:text="Eğit" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ogret_gonder"
                    style="@style/IkincilDugme"
                    android:layout_marginEnd="5dp"
                    android:text="Bilgisayara gönder"
                    app:drawableStartCompat="@drawable/ic_gonder" />

                <TextView
                    android:id="@+id/ogret_yukle"
                    style="@style/IkincilDugme"
                    android:layout_marginStart="5dp"
                    android:text="Model yükle"
                    app:drawableStartCompat="@drawable/ic_yukle" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
