<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.Kamera" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Yeni arayüz (Claude Design: "Dedektör Arayüzü"). Yazı: Manrope, sayılar ve başlıklar: Space Grotesk. -->
    <style name="CamHap">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/cam_hap</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="CamDaire">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/cam_daire</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/yazi</item>
    </style>

    <style name="Ipucu">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/cam_hap</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:fontFamily">@font/manrope_kalin</item>
        <item name="android:textColor">@color/yazi_cam</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Sayi">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/space_grotesk_kalin</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/yazi</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="YaprakBasligi">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/space_grotesk_kalin</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/yazi</item>
    </style>

    <style name="BolumEtiketi">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:fontFamily">@font/manrope_cok_kalin</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/soluk</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SatirBasligi">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/manrope_kalin</item>
        <item name="android:textColor">@color/yazi</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SatirAciklama">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/manrope_orta</item>
        <item name="android:textColor">@color/soluk</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="AnaDugme">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/dolu_hap</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:fontFamily">@font/manrope_cok_kalin</item>
        <item name="android:textColor">@color/vurgu_ustu</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="IkincilDugme">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/ikincil_hap</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:fontFamily">@font/manrope_kalin</item>
        <item name="android:textColor">@color/yazi_ikincil</item>
        <item name="android:textSize">14sp</item>
        <item name="drawableTint">@color/yazi_ikincil</item>
    </style>

    <style name="Anahtar">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:thumb">@drawable/anahtar_top</item>
        <item name="track">@drawable/anahtar_iz</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>